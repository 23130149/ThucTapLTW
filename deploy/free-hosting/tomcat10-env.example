# Copy cac dong JAVA_OPTS nay vao /etc/default/tomcat10 tren server.
# Doi tat ca CHANGE_ME truoc khi restart Tomcat.

JAVA_OPTS="$JAVA_OPTS -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Ho_Chi_Minh"

# Database production
JAVA_OPTS="$JAVA_OPTS -Ddb.host=localhost"
JAVA_OPTS="$JAVA_OPTS -Ddb.port=3306"
JAVA_OPTS="$JAVA_OPTS -Ddb.username=handmade_user"
JAVA_OPTS="$JAVA_OPTS -Ddb.password=CHANGE_ME_DB_PASSWORD"
JAVA_OPTS="$JAVA_OPTS -Ddb.dbName=project"
JAVA_OPTS="$JAVA_OPTS -Ddb.dbOption=useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh"

# Google reCAPTCHA v2 Checkbox
JAVA_OPTS="$JAVA_OPTS -DRECAPTCHA_SITE_KEY=CHANGE_ME_RECAPTCHA_SITE_KEY"
JAVA_OPTS="$JAVA_OPTS -DRECAPTCHA_SECRET_KEY=CHANGE_ME_RECAPTCHA_SECRET_KEY"

# GHN
JAVA_OPTS="$JAVA_OPTS -Dghn.mode=simulation"
JAVA_OPTS="$JAVA_OPTS -Dghn.base_url=https://online-gateway.ghn.vn/shiip/public-api"
JAVA_OPTS="$JAVA_OPTS -Dghn.token=CHANGE_ME_GHN_TOKEN"
JAVA_OPTS="$JAVA_OPTS -Dghn.shop_id=CHANGE_ME_GHN_SHOP_ID"
JAVA_OPTS="$JAVA_OPTS -Dghn.service_id=CHANGE_ME_GHN_SERVICE_ID"
JAVA_OPTS="$JAVA_OPTS -Dghn.from_name=Handmade House"
JAVA_OPTS="$JAVA_OPTS -Dghn.from_phone=CHANGE_ME_SHOP_PHONE"
JAVA_OPTS="$JAVA_OPTS -Dghn.from_address=CHANGE_ME_SHOP_ADDRESS"
JAVA_OPTS="$JAVA_OPTS -Dghn.from_province_name=CHANGE_ME_SHOP_PROVINCE"
JAVA_OPTS="$JAVA_OPTS -Dghn.from_district_name=CHANGE_ME_SHOP_DISTRICT"
JAVA_OPTS="$JAVA_OPTS -Dghn.from_ward_name=CHANGE_ME_SHOP_WARD"
JAVA_OPTS="$JAVA_OPTS -Dghn.from_district_id=CHANGE_ME_FROM_DISTRICT_ID"
JAVA_OPTS="$JAVA_OPTS -Dghn.from_ward_code=CHANGE_ME_FROM_WARD_CODE"
